
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "savanna-browser",
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": "./web"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": true
    }
  }
}
